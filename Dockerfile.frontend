FROM oven/bun:1.4.4 AS build

WORKDIR /app

# Install dependencies (Bun als Paketmanager; Lockfile ist bun.lock)
COPY package.json bun.lock ./
# --ignore-scripts: der Frontend-Build braucht keine nativen Addons (keytar/argon2)
# und keinen signal-cli-Download aus dem postinstall-Hook.
RUN bun install --frozen-lockfile --ignore-scripts

# Copy project files
COPY . .

# Build Vite frontend
RUN bun run build

# Production server using Nginx
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
